{
  "name": "grange-ai",
  "version": "1.0.0",
  "description": "Grange AI desktop app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "electron .",
    "build": "vite build && electron-builder"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "vite": "^5.0.10"
  },
  "build": {
    "appId": "com.grangeai.app",
    "productName": "Grange AI",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*"],
    "mac": { "icon": "assets/icon.png", "target": "dmg" },
    "win": { "icon": "assets/icon.png", "target": "nsis" },
    "linux": { "icon": "assets/icon.png", "target": "AppImage" }
  }
}
